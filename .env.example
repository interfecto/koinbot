# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Optional: chat ID that receives auto-updater notifications
# (deploys, pending code changes, validation failures)
ADMIN_CHAT_ID=

# Optional: group chat ID for automatic "new X post" announcements
# (unset disables the auto-poster); poll interval in seconds
MAIN_CHAT_ID=
X_POLL_SECONDS=300

# Optional: comma-separated RSS feed URLs (swap in another Nitter
# instance if the default dies)
#X_FEED_URLS=https://nitter.net/koinosnetwork/rss

# Kai (@kai) — AI answers in the main group via the Koinos AI worker
# network (koinosai.com). URL of a Koinos AI Core /v1/chat/completions
# endpoint reachable from the container, e.g. through an SSH tunnel.
# Unset disables the feature. Requires MAIN_CHAT_ID.
KAI_API_URL=
#KAI_MODEL=koinos-network:koinos-fast
#KAI_TIMEOUT_SECONDS=120
#KAI_MAX_TOKENS=350
#KAI_MAX_QUESTION=500
#KAI_USER_COOLDOWN=15
#KAI_WINDOW_LIMIT=30
#KAI_WINDOW_SECONDS=900
#KAI_MAX_PENDING=4
# Web search context for every question (via the gateway's /core/search;
# DuckDuckGo snippets, question only, never chat history). On by
# default; set 0 to disable. Used on the network path (explicit model
# picks and grounding fallback).
#KAI_WEB_SEARCH=1

# Grounded default answers (Koinos AI Core >= 0.42 'koinos.ground'):
# the question runs on KAI_LOCAL_MODEL on our own Core, which reads
# the web + the source allowlist and returns citations. On by default;
# set KAI_GROUND=0 to fall back to network + snippets for everything.
#KAI_GROUND=1
#KAI_LOCAL_MODEL=gemma3-12b
#KAI_GROUND_SOURCES=https://docs.koinos.io/**,https://koinos.io/**
#KAI_GROUND_TIMEOUT=60
